# Supabase — the profit tracker's project (review_tracker schema)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Amazon SP-API — same app/credentials as the profit tracker
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
LWA_REFRESH_TOKEN=
# SPAPI_MARKETPLACE_ID=ATVPDKIKX0DER

# Keepa — ratings counts (Amazon's APIs don't expose them)
KEEPA_API_KEY=
# KEEPA_RESERVE_TOKENS=100

# Email via Resend
RESEND_API_KEY=
MAIL_FROM=Review Alerts <alerts@your-verified-domain.com>
ALERT_TO=
# ALERT_CC=
ADMIN_EMAIL=

# Protects /api/cron and /api/test-email (Vercel Cron sends it automatically)
CRON_SECRET=
# Password for the status page and email preview
SITE_PASSWORD=

# Tuning (defaults shown)
# SEND_HOUR=8
# ALERT_MIN_DROP=10
# ALERT_MIN_DROP_PCT=10
